{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/thanachot30/hostSchema/main/student/student_schema_vc.json",
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string" }
    },
    "id": { "type": "string" },
    "type": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string" }
    },
    "issuer": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "issuanceDate": { "type": "string" },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "degree": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        }
      }
    },
    "credentialSchema": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "type"]
    }
  },
  "required": [
    "@context",
    "type",
    "issuer",
    "issuanceDate",
    "credentialSubject",
    "credentialSchema"
  ]
}
